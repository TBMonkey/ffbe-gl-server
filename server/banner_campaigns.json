{
 "_meta": {
  "what": "HOME marquee ERA TABLE: the community late-service events a banner could promote, grouped into month-long eras, with the art we actually hold marked per event.",
  "provenance": "events = [Community] (exvius.fandom.com, via server/community_events.json). art = the CLIENT'S OWN downloaded marquee cache. The era grouping, the class filter and the instance-level art join are OURS and are selection decisions, not recovered data.",
  "generator": "harness/gen_banner_campaigns.py",
  "client_version": {
   "version": "9.0.0",
   "date": "2024-06-30",
   "era": "2024-06",
   "note": "the v9.0.0 build under analysis. Its version month is recorded here for provenance but is NOT the default: it holds 2 marquee-class events and 0 joinable art, so a run there renders an empty marquee. The client's banner CACHE spans 2022-2024, so which era it actually saw depends on when it was run, not on when it shipped."
  },
  "default_rationale": "latest era with at least one joinable banner; a wall-clock default would describe a client that does not exist, and the version month has no art.",
  "servable_eras": [
   "2022-06",
   "2023-06",
   "2024-03",
   "2024-08"
  ],
  "event_classes": [
   "Series Event",
